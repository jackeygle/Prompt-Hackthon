# Required
YOUTUBE_API_KEY=        # YouTube Data API v3 (metrics, comments, discovery)
GROQ_API_KEY=           # primary text LLM (spec, relevance, content + comment features, web mention extraction)
# Optional enrichments (pipeline still runs without them; confidence/coverage reflect what is missing)
OPENAI_API_KEY=         # ChatGPT web search (default creator discovery) + thumbnail visual analysis (VLM)
TAVILY_API_KEY=         # alternative web search (WEB_SEARCH_PROVIDER=tavily, or fallback when ChatGPT finds nothing)
GEMINI_API_KEY=         # fallback text LLM when Groq is unavailable/rate-limited
TWITCH_CLIENT_ID=       # Twitch streamer discovery + follower/VOD metrics (free: dev.twitch.tv/console)
TWITCH_CLIENT_SECRET=
INSTAGRAM_ACCESS_TOKEN= # Instagram follower/engagement enrichment (Meta app, Facebook Login user token, 60-day)
# INSTAGRAM_USER_ID=    # your IG professional account id (auto-detected via /me/accounts)

# Optional overrides
# LLM_MODELS=groq/meta-llama/llama-4-scout-17b-16e-instruct,groq/openai/gpt-oss-20b,gemini/gemini-3.5-flash
# VLM_MODELS=openai/gpt-4.1-nano,openai/gpt-5-nano,openai/gpt-4o-mini
# GROQ_RPM=25  GEMINI_RPM=5  OPENAI_RPM=60      # requests/minute per model
# WEB_SEARCH_PROVIDER=openai  WEB_SEARCH_MODEL=gpt-4.1-mini   # or WEB_SEARCH_PROVIDER=tavily
# WEB_DISCOVERY_ENABLED=1  VLM_ENABLED=1  TRANSCRIPTS_ENABLED=1  TWITCH_ENABLED=1  INSTAGRAM_ENABLED=1
