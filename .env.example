# Required
YOUTUBE_API_KEY=        # YouTube Data API v3 (metrics, comments, discovery)
AZURE_OPENAI_ENDPOINT=  # e.g. https://<resource>.services.ai.azure.com/openai/v1/responses
AZURE_OPENAI_API_KEY=   # gpt-5.6-sol for the whole pipeline: text extraction, thumbnails (VLM), web search
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-sol
# Optional enrichments (pipeline still runs without them; confidence/coverage reflect what is missing)
TAVILY_API_KEY=         # web-search fallback when the gpt-5.6-sol web search fails (WEB_SEARCH_PROVIDER=tavily to force)
OPENAI_API_KEY=         # optional: OpenAI instead of Azure (WEB_SEARCH_PROVIDER=openai, openai/<model> in LLM_MODELS)
GROQ_API_KEY=           # optional fallback text LLMs (add groq/... or gemini/... to LLM_MODELS)
GEMINI_API_KEY=
TWITCH_CLIENT_ID=       # Twitch streamer discovery + follower/VOD metrics (free: dev.twitch.tv/console)
TWITCH_CLIENT_SECRET=
INSTAGRAM_ACCESS_TOKEN= # Instagram follower/engagement enrichment (Meta app, Facebook Login user token, 60-day)
# INSTAGRAM_USER_ID=    # your IG professional account id (auto-detected via /me/accounts)

# Optional overrides
# LLM_MODELS=azure/gpt-5.6-sol                   # default; append fallbacks, e.g. ,groq/openai/gpt-oss-20b
# VLM_MODELS=azure/gpt-5.6-sol                   # default
# AZURE_RPM=60  GROQ_RPM=25  GEMINI_RPM=5  OPENAI_RPM=60   # requests/minute per model
# WEB_SEARCH_PROVIDER=azure                      # default (gpt-5.6-sol + web_search tool); or openai / tavily
# N_QUERIES=6  N_CREATOR_QUERIES=2               # topic/content vs direct "top creator" YouTube searches
# WEB_DISCOVERY_ENABLED=1  VLM_ENABLED=1  TRANSCRIPTS_ENABLED=1  TWITCH_ENABLED=1  INSTAGRAM_ENABLED=1
